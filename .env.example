# ============================================
# Stock Portfolio Intelligence Platform
# Environment Configuration
# ============================================
# Copy this file to .env and fill in values

# Database (SQLite default - change for PostgreSQL)
DATABASE_URL=sqlite:///./data/portfolio.db

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cache TTL (seconds)
PRICE_CACHE_TTL=300
FUNDAMENTALS_CACHE_TTL=86400
NEWS_CACHE_TTL=1800
TECHNICAL_CACHE_TTL=900
ANALYSIS_CACHE_TTL=3600

# ============================================
# OPTIONAL: Free-tier API Keys
# ============================================
# Finnhub (free registration at https://finnhub.io)
# Provides: company news, basic sentiment, earnings calendar
FINNHUB_API_KEY=

# ============================================
# OPTIONAL: LLM Providers (not required)
# ============================================
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama (local LLM - no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Active LLM provider: none | openai | anthropic | ollama
LLM_PROVIDER=none

# ============================================
# Data Settings
# ============================================
# Max concurrent yfinance requests
MAX_CONCURRENT_REQUESTS=5

# Background refresh interval (minutes)
DATA_REFRESH_INTERVAL=30

# Log level
LOG_LEVEL=INFO
